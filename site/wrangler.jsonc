// Static landing page for a23crypt, served as Workers static assets.
// `bun run dev` serves it locally; `bun run deploy` publishes it.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "a23crypt",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  }
}
